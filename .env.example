# Copy to .env, fill in the keys, then: set -a; source .env; set +a
JEV_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=

JEV_MODEL=jev-1.13.0
LLM_MODEL=gpt-4o-mini-2024-07-18
ISSUES_PER_TEAM=50
MAX_INPUT_CHARS=12000
DATA_DIR=data
RESULTS_DIR=results
CONFIDENCE_THRESHOLDS=0,0.5,0.7,0.9

# Optional inclusive UTC creation dates. Omit to use the last 180 days.
# SINCE_DATE=2026-03-22
# UNTIL_DATE=2026-09-18

# Optional USD prices per million tokens. Blank means unknown, not free.
# Set BOTH input and output rates per provider to estimate its cost.
JEV_INPUT_USD_PER_MILLION=
JEV_OUTPUT_USD_PER_MILLION=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
